              "raw": "{{baseUrl}}/quiz/attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quiz",
                "attempts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"situation\": \"btn_open\", \"stack\": 25, \"hand\": \"72o\", \"given\": \"ALLIN\", \"correct\": true}"
            }
          }
        },
        {
          "name": "Historial: primera página",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const page = pm.response.json();",
                  "pm.test('200 con un intento y cursor a la siguiente página', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(page.items).to.have.lengthOf(1);",
                  "  pm.expect(page.nextCursor).to.be.a('string').that.is.not.empty;",
                  "});",
                  "pm.collectionVariables.set('cursor', page.nextCursor);",
                  "pm.collectionVariables.set('firstAttemptId', page.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quiz/attempts?limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quiz",
                "attempts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Historial: última página",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const page = pm.response.json();",
                  "pm.test('200 con el otro intento y sin más páginas', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(page.items).to.have.lengthOf(1);",
                  "  pm.expect(page.items[0].id).to.not.eql(pm.collectionVariables.get('firstAttemptId'));",
                  "  pm.expect(page).to.have.property('nextCursor', null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quiz/attempts?limit=1&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quiz",
                "attempts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            }
          }
        }
      ]
