{
  "info": {
    "name": "Spin Trainer API · regresión",
    "description": "Flujo completo de un jugador nuevo contra la API (contrato v0.2): catálogo, rangos de referencia, rango personalizado con versiones, Quiz corregido en el servidor, historial paginado, estadísticas y borrado. Las peticiones dependen unas de otras: se ejecuta en orden y con un token de un usuario sin datos (`npm run newman` lo genera). La validación de cada respuesta contra la spec la hace la suite de Java; aquí se comprueba el comportamiento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Comprobaciones comunes a todas las respuestas.",
          "const correlationId = pm.response.headers.get('X-Correlation-Id');",
          "pm.test('Devuelve X-Correlation-Id', () => {",
          "  pm.expect(correlationId).to.be.a('string').that.is.not.empty;",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test('El error es un Problem Details (RFC 9457)', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "    const problem = pm.response.json();",
          "    pm.expect(problem.type).to.match(/^urn:spin-trainer:[a-z-]+$/);",
          "    pm.expect(problem.status).to.eql(pm.response.code);",
          "    pm.expect(problem.correlationId).to.eql(correlationId);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "catalogEtag",
      "value": ""
    },
    {
      "key": "cursor",
      "value": ""
    },
    {
      "key": "firstAttemptId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Catálogo",
      "description": "Las 16 situaciones de Spin & Go; cambian solo con una migración, así que se revalidan con ETag.",
      "item": [
        {
          "name": "Lista las 16 situaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con las 16 situaciones', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(16);",
                  "});",
                  "pm.test('Se revalida con ETag', () => {",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-cache');",
                  "  pm.expect(pm.response.headers.get('ETag')).to.be.a('string').that.is.not.empty;",
                  "});",
                  "pm.collectionVariables.set('catalogEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/situations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "situations"
              ]
            }
          }
        },
        {
          "name": "Sin cambios: 304",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('304 sin cuerpo', () => {",
                  "  pm.response.to.have.status(304);",
                  "  pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "{{catalogEtag}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/situations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "situations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rangos de referencia",
      "description": "Seed de QA: btn_open a 25 BB (env/flyway).",
      "item": [
        {
          "name": "btn_open a 25 BB",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const range = pm.response.json();",
                  "pm.test('200 con el rango de referencia', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(range.source).to.eql('default');",
                  "});",
                  "pm.test('Lista las manos jugadas; las demás llevan la acción implícita', () => {",
                  "  pm.expect(range.hands.AA).to.eql('MR_4B_C');",
                  "  pm.expect(range.hands).to.not.have.property('72o');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ranges/default/btn_open/25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
