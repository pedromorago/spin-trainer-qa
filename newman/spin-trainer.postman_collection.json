    {
      "name": "Estadísticas",
      "description": "Agregados sobre los intentos, calculados por la API.",
      "item": [
        {
          "name": "Por mano",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Una fila por mano respondida', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const rows = pm.response.json().map(({ hand, attempts, correct }) => ({ hand, attempts, correct }));",
                  "  pm.expect(rows).to.have.deep.members([",
                  "    { hand: 'A5s', attempts: 1, correct: 1 },",
                  "    { hand: 'AA', attempts: 1, correct: 0 },",
                  "  ]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats/hands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats",
                "hands"
              ]
            }
          }
        },
        {
          "name": "Progreso de la última semana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Los dos intentos, uno correcto', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const days = pm.response.json();",
                  "  const sum = (field) => days.reduce((total, day) => total + day[field], 0);",
                  "  pm.expect(sum('attempts')).to.eql(2);",
                  "  pm.expect(sum('correct')).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats/progress?days=7&tz=Europe/Madrid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats",
                "progress"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "7"
                },
                {
                  "key": "tz",
                  "value": "Europe/Madrid"
                }
              ]
            }
          }
        }
      ]
    },
