    {
      "name": "Quiz",
      "description": "El servidor corrige con el rango efectivo (ADR-0012, ADR-0013); los intentos son eventos inmutables (ADR-0007).",
      "item": [
        {
          "name": "Respuesta correcta según mi rango",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = pm.response.json();",
                  "pm.test('201 corregida con mi rango en la versión 2', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(attempt.expected).to.eql('ALLIN');",
                  "  pm.expect(attempt.correct).to.be.true;",
                  "  pm.expect(attempt.rangeSource).to.eql('user');",
                  "  pm.expect(attempt.rangeVersion).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quiz/attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quiz",
                "attempts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"situation\": \"btn_open\", \"stack\": 25, \"hand\": \"A5s\", \"given\": \"ALLIN\"}"
