          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ranges/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ranges",
                "user"
              ]
            }
          }
