    {
      "name": "Rango personalizado",
      "description": "Cada guardado dice de qué versión parte; si no es la actual, 409 y no se pisa nada (ADR-0013).",
      "item": [
        {
          "name": "Crea la versión 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const range = pm.response.json();",
                  "pm.test('201 en la versión 1', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(range.version).to.eql(1);",
                  "  pm.expect(range.source).to.eql('user');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ranges/user/btn_open/25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ranges",
                "user",
                "btn_open",
                "25"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hands\": {\"A5s\": \"ALLIN\"}, \"version\": 0}"
            }
          }
        },
        {
          "name": "Guardar desde una versión antigua: 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 con la versión actual', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().detail).to.eql('El rango está en la versión 1; recarga');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ranges/user/btn_open/25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ranges",
                "user",
                "btn_open",
                "25"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hands\": {\"QQ\": \"ALLIN\"}, \"version\": 0}"
            }
          }
        },
        {
          "name": "Reemplaza la versión 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 en la versión 2', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().version).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ranges/user/btn_open/25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ranges",
                "user",
                "btn_open",
                "25"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hands\": {\"A5s\": \"ALLIN\", \"KK\": \"MR_4B_C\"}, \"version\": 1}"
            }
          }
        },
        {
          "name": "Lee el rango guardado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const range = pm.response.json();",
                  "pm.test('200 con lo último que se guardó', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(range.version).to.eql(2);",
                  "  pm.expect(range.hands).to.eql({ A5s: 'ALLIN', KK: 'MR_4B_C' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ranges/user/btn_open/25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ranges",
                "user",
                "btn_open",
                "25"
              ]
            }
          }
        },
        {
          "name": "Lista mis rangos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Un rango personalizado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ranges = pm.response.json();",
                  "  pm.expect(ranges).to.have.lengthOf(1);",
                  "  pm.expect(ranges[0].situation).to.eql('btn_open');",
