{
  "name": "spin-trainer-qa",
  "private": true,
  "type": "module",
  "description": "Regresión de colección (Newman) y E2E (Playwright) de Spin Trainer",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "env:up": "docker compose -f env/docker-compose.yml up -d --build --wait",
    "env:down": "docker compose -f env/docker-compose.yml down -v",
    "newman": "node scripts/newman.mjs",
    "e2e": "playwright test -c e2e",
    "e2e:mock": "playwright test -c e2e --project=mock",
    "e2e:fullstack": "playwright test -c e2e --project=fullstack",
    "e2e:typecheck": "tsc -p e2e",
    "report": "allure generate api-tests/build/allure-results build/allure-results/newman build/allure-results/e2e",
    "report:open": "allure open build/allure-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "allure": "3.18.0",
    "allure-playwright": "3.12.2",
    "newman": "6.2.2",
    "newman-reporter-allure": "3.12.2",
    "typescript": "7.0.2"
  }
}
