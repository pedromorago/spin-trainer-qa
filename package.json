{
  "name": "spin-trainer-qa",
  "private": true,
  "type": "module",
  "description": "Regresión de colección (Newman) y E2E (Playwright) de Spin Trainer",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "env:up": "docker compose -f env/docker-compose.yml up -d --build --wait",
    "env:down": "docker compose -f env/docker-compose.yml down -v",
    "newman": "node scripts/newman.mjs"
  },
  "devDependencies": {
    "newman": "6.2.2",
    "newman-reporter-allure": "3.12.2"
  }
}
